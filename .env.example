# ─── 必选 ───────────────────────────────────────────────────────────────────

# PostgreSQL 数据库连接（Supabase Transaction Pooler 推荐）
POSTGRES_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase 服务角色密钥（用于服务端操作）
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Better Auth 密钥（生成方式：openssl rand -base64 32）
BETTER_AUTH_SECRET=your-secret-key-here

# Supabase 项目 URL（客户端使用）
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co

# ─── 可选 ───────────────────────────────────────────────────────────────────

# Google Maps API key（启用地址搜索）
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Resend 邮件服务（如启用邮箱验证/密码重置）
# RESEND_API_KEY=...

# 应用基础 URL（用于 auth 回调和分享链接生成）
# NEXT_PUBLIC_APP_URL=http://localhost:3002

# Dev server port
# PORT=3002
