# ====================================================================
# VilHil Studio — 生产环境变量模板
# 部署前复制为 .env.production.local，填入真实值
# ====================================================================

# ── Better Auth ──────────────────────────────────────────────────────
# 必须是 32 字节以上的强随机字符串，不能是 dev 默认值
# 生成命令：openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── 应用 URL（build-time + runtime 都需要）───────────────────────────
# 必须与 Nginx server_name / 域名完全一致，结尾不加斜线
NEXT_PUBLIC_APP_URL=https://studio.vilhil.cn

# ── PostgreSQL ───────────────────────────────────────────────────────
# 阿里云 RDS（推荐）或 ECS 自建 PostgreSQL
# 格式：postgresql://用户名:密码@主机:端口/数据库名
POSTGRES_URL=postgresql://vilhil:your_password@your-rds-host.rds.aliyuncs.com:5432/vilhil_prod

# ── 运行时端口（Node.js 服务监听，Nginx 代理到此端口）────────────────
PORT=3000
