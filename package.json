{
  "name": "editor",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev-service.mjs run",
    "dev:start": "node scripts/dev-service.mjs start",
    "dev:stop": "node scripts/dev-service.mjs stop",
    "dev:status": "node scripts/dev-service.mjs status",
    "test:dev-service": "node --test scripts/dev-service.test.mjs",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "check:fix": "biome check --write",
    "check-types": "turbo run check-types",
    "kill": "node scripts/dev-service.mjs stop",
    "release": "gh workflow run release.yml -f package=both -f bump=patch",
    "release:viewer": "gh workflow run release.yml -f package=viewer -f bump=patch",
    "release:core": "gh workflow run release.yml -f package=core -f bump=patch",
    "release:minor": "gh workflow run release.yml -f package=both -f bump=minor",
    "release:major": "gh workflow run release.yml -f package=both -f bump=major"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@swc/helpers": "^0.5.21",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.9.5",
    "typescript": "5.9.3",
    "ultracite": "^7.2.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "overrides": {
    "@react-three/fiber": "^9.5.0",
    "@react-three/drei": "^10.7.7"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2"
  }
}
